NETWORK=flare
FLARE_RPC=https://flare-api.flare.network/ext/bc/C/rpc

# Public address expected to correspond to CLAIM_EXECUTOR_PRIVATE_KEY. The
# process refuses to send transactions if the key resolves to another address.
CLAIM_EXECUTOR_ADDRESS=
CLAIM_EXECUTOR_PRIVATE_KEY=

# Used only for DIRECT and FEE rewards. If set, this address must be allowlisted
# by the applicable beneficiary in ClaimSetupManager. It has no effect on FTSO
# delegation or validator staking rewards.
CLAIM_RECIPIENT_ADDRESS=

# Used as the default for every category-specific list below.
REWARD_OWNER_ADDRESSES=

# Optional category-specific overrides (comma or whitespace separated).
DIRECT_BENEFICIARY_ADDRESSES=
FEE_BENEFICIARY_ADDRESSES=
FTSO_REWARD_OWNER_ADDRESSES=
VALIDATOR_REWARD_OWNER_ADDRESSES=

# Each reward type pays native FLR by default. Set an individual value to true
# to receive WFLR for that reward type.
DIRECT_WRAP_REWARDS=false
FEE_WRAP_REWARDS=false
FTSO_WRAP_REWARDS=false
VALIDATOR_WRAP_REWARDS=false
POLL_INTERVAL_MINUTES=12
MAX_PROOFS_PER_TRANSACTION=40

# Optional contract overrides. Defaults are built in for Flare mainnet.
FLARE_SYSTEMS_MANAGER_ADDRESS=
REWARD_MANAGER_ADDRESS=
CLAIM_SETUP_MANAGER_ADDRESS=
VALIDATOR_REWARD_MANAGER_ADDRESS=
